# Copy to .env outside version control; replace every value.
CHANNEL_ADMIN_TOKEN=replace-with-random-token
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
OPENCLAW_GATEWAY_TOKEN=match-the-isolated-gateway-token
# Use a quoted multiline PEM value in .env or supply via a secret manager.
GITHUB_APP_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
replace-with-your-app-private-key
-----END PRIVATE KEY-----'
